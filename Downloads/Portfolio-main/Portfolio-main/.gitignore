# .gitignore for Nabin Dhakal Portfolio (Cloudflare/D1/Frontend)

# Node modules and build outputs
node_modules/
dist/
build/
.cache/
.next/
out/

# Cloudflare Wrangler
wrangler.toml
wrangler.log
.cloudflare/

# Environment variables and secrets
.env
.env.*
*.local

# System files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
logs/

# VS Code and editor settings
.vscode/
.idea/
*.code-workspace

# Test and coverage
coverage/
*.lcov

# Database and generated files
*.sqlite
*.db
*.db-journal
*.sqlite3

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore files folder (public resumes, etc)
/files/

# Ignore documentation drafts
/documentation/drafts/
